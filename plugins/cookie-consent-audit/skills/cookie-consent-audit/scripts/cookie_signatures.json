{
  "_comment": "Cookie NAME signatures. Most analytics/ad platforms set first-party cookies (_ga, _fbp, _hjSessionUser), so domain matching alone misses them. A trailing * matches by prefix; otherwise the match is exact. Names are compared case-insensitively.",
  "Google Analytics (GA4/UA)": ["_ga", "_ga_*", "_gid", "_gat", "_gat_*", "__utma", "__utmb", "__utmc", "__utmt", "__utmz"],
  "Google Ads / Remarketing": ["_gcl_au", "_gcl_aw", "_gcl_dc", "_gac_*", "IDE", "test_cookie"],
  "Meta / Facebook Pixel": ["_fbp", "_fbc", "fr"],
  "Hotjar": ["_hjSessionUser*", "_hjSession*", "_hjid", "_hjIncludedInSessionSample*", "_hjAbsoluteSessionInProgress", "_hjFirstSeen", "_hjTLDTest"],
  "Microsoft Clarity": ["_clck", "_clsk", "CLID", "MUID", "ANONCHK", "SRM_B"],
  "Microsoft Advertising (UET)": ["_uetsid", "_uetvid", "_uetmsclkid"],
  "LinkedIn Insight Tag": ["li_sugr", "bcookie", "bscookie", "lidc", "UserMatchHistory", "AnalyticsSyncHistory", "li_gc"],
  "TikTok Pixel": ["_ttp", "ttwid", "tt_sessionId", "tt_appInfo"],
  "HubSpot": ["hubspotutk", "__hstc", "__hssrc", "__hssc", "__hs_*"],
  "Pinterest Tag": ["_pinterest_ct_ua", "_pin_unauth", "_epik"],
  "Snapchat Pixel": ["_scid", "sc_at", "_schn", "_scid_r"],
  "Twitter / X Ads": ["personalization_id", "muc_ads", "guest_id"],
  "Segment": ["ajs_anonymous_id", "ajs_user_id", "ajs_group_id"],
  "Mixpanel": ["mp_*"],
  "Adobe Analytics": ["s_cc", "s_sq", "s_vi", "s_fid", "AMCV_*", "AMCVS_*"],
  "Criteo": ["cto_bundle", "cto_bidid", "cto_tld_test"],
  "Intercom": ["intercom-id-*", "intercom-session-*", "intercom-device-id-*"],
  "Drift": ["drift_aid", "driftt_aid", "drift_campaign_refresh"],
  "Klaviyo": ["__kla_id"],
  "Matomo": ["_pk_id*", "_pk_ses*", "_pk_ref*"],
  "Consent Manager (CMP)": ["cookieyes-consent", "OptanonConsent", "OptanonAlertBoxClosed", "CookieConsent", "cookie_consent*", "termly*", "osano_consentmanager*", "uc_settings", "CONSENT"],
  "Stripe": ["__stripe_mid", "__stripe_sid"],
  "reCAPTCHA": ["_GRECAPTCHA"],
  "CleanTalk": ["ct_*", "apbct_*"]
}
